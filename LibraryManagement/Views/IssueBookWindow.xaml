<Window x:Class="LibraryManagement.Views.IssueBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выдача книги"
        Height="300"
        Width="400">

    <StackPanel Margin="20">

        <TextBlock Text="Читатель"/>

        <ComboBox x:Name="ReadersBox"
                  Margin="0,5,0,15"/>

        <TextBlock Text="Книга"/>

        <ComboBox x:Name="BooksBox"
                  Margin="0,5,0,15"/>

        <Button Content="Выдать"
                Height="35"
                Click="IssueButton_Click"/>

    </StackPanel>

</Window>