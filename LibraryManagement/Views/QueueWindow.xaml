<Window x:Class="LibraryManagement.Views.QueueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Очередь на книги"
        Height="500"
        Width="850">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Добавление читателя в очередь"
                  Grid.Row="0"
                  Margin="0,0,0,10">

            <Grid Margin="10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Читатель"/>

                    <ComboBox x:Name="ReadersBox"
                              Height="30"
                              Margin="0,5,0,0"/>

                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                    <TextBlock Text="Книга"/>

                    <ComboBox x:Name="BooksBox"
                              Height="30"
                              Margin="0,5,0,0"/>

                </StackPanel>

                <Button Grid.Column="2"
                        Content="Поставить в очередь"
                        Width="160"
                        Height="35"
                        VerticalAlignment="Bottom"
                        Click="AddQueueButton_Click"/>

            </Grid>

        </GroupBox>

        <DataGrid x:Name="QueueGrid"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  IsReadOnly="True"
                  Margin="0,0,0,10"/>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">

            <Button Content="Обновить"
                    Width="120"
                    Height="35"
                    Margin="5"
                    Click="RefreshButton_Click"/>

            <Button Content="Удалить из очереди"
                    Width="160"
                    Height="35"
                    Margin="5"
                    Click="DeleteQueueButton_Click"/>

        </StackPanel>

    </Grid>
</Window>