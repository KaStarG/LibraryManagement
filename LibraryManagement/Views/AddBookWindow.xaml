<Window x:Class="LibraryManagement.Views.AddBookWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление книги"
        Height="350"
        Width="400">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="Название книги"/>
            <TextBox x:Name="TitleBox"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Год издания"/>
            <TextBox x:Name="YearBox"
                     Margin="0,5,0,15"/>

            <TextBlock Text="Количество страниц"/>
            <TextBox x:Name="PagesBox"
                     Margin="0,5,0,15"/>

            <CheckBox x:Name="ReadingRoomBox"
                      Content="Только для читального зала"
                      Margin="0,0,0,20"/>

            <Button Content="Сохранить"
                    Height="35"
                    Click="SaveButton_Click"/>

        </StackPanel>

    </Grid>
</Window>